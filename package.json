{
  "name": "raw-browser",
  "version": "0.7.0",
  "description": "Drive the Chrome or Edge you're already signed into from one script — a zero-dependency browser automation runtime, CLI and MCP server for AI agents.",
  "keywords": [
    "ai",
    "ai-agents",
    "agent",
    "automation",
    "browser",
    "browser-automation",
    "cdp",
    "chrome",
    "chrome-devtools-protocol",
    "chrome-extension",
    "edge",
    "mcp",
    "mcp-server"
  ],
  "license": "MIT",
  "author": "liutingqiu",
  "funding": {
    "type": "individual",
    "url": "https://paypal.me/tianqi689"
  },
  "type": "module",
  "bin": {
    "raw": "dist/browser-cli.js",
    "raw-bridge": "scripts/raw-bridge.mjs",
    "raw-mcp": "mcp/raw-browser-mcp.mjs"
  },
  "files": [
    "dist",
    "scripts",
    "mcp",
    "docs",
    "demo",
    "assets",
    "edge-bridge/extension",
    "edge-bridge/host/Program.cs",
    "edge-bridge/host/RawEdgeBridge.csproj",
    "edge-bridge/README.md",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.21.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node --no-warnings scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-versions.mjs && npm run typecheck && npm test && npm run build && node scripts/smoke-browser.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "prepublishOnly": "npm run check",
    "prepack": "node --no-warnings scripts/build.mjs",
    "start": "node src/browser-cli.ts",
    "dev": "node src/browser-cli.ts",
    "test": "node --no-warnings --test",
    "smoke:browser": "npm run build && node scripts/smoke-browser.mjs",
    "smoke:bridge": "dotnet build edge-bridge/host/RawEdgeBridge.csproj -c Release --nologo && npm run build && node scripts/smoke-bridge.mjs",
    "browser": "node src/browser-cli.ts",
    "demo": "npm run build && node scripts/demo.mjs",
    "social-card": "npm run build && node scripts/render-social-card.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liutingqiu/raw-browser.git"
  },
  "bugs": {
    "url": "https://github.com/liutingqiu/raw-browser/issues"
  },
  "homepage": "https://github.com/liutingqiu/raw-browser#readme",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
